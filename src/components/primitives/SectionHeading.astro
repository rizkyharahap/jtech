---
interface Props {
  id?: string;
  /** Tailwind text colour class, e.g. 'text-navy-900' or 'text-white' */
  color?: string;
  size?: 'lg' | 'md';
  class?: string;
}
const { id, color = 'text-navy-900', size = 'lg', class: cls = '' } = Astro.props;
const sizes = {
  lg: 'text-[clamp(1.75rem,3.1vw,2.75rem)]',
  md: 'text-[clamp(1.5rem,2.4vw,2rem)]',
};
---
<h2 id={id} data-reveal="up" style="--rv-delay:60ms"
    class:list={['mt-5 font-semibold leading-tight', sizes[size], color, cls]}>
  <slot />
</h2>
