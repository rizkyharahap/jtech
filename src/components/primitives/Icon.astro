---
/** Inline SVG icons — avoids an icon dependency. */
interface Props { name: IconName; size?: number; class?: string }
export type IconName =
  | 'arrow-right' | 'wrench' | 'building' | 'box' | 'doc' | 'sun' | 'layers'
  | 'truck' | 'shield' | 'quote' | 'phone' | 'mail' | 'pin' | 'link' | 'cart' | 'whatsapp';
const { name, size = 22, class: cls = '' } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'wrench': '<path d="M14.7 6.3a4 4 0 0 0 5 5l-8.4 8.4a2.8 2.8 0 0 1-4-4zM3 3l5 5"/>',
  'building': '<path d="M4 20V4h10l6 6v10zM14 4v6h6"/>',
  'box': '<path d="M21 16V8l-9-5-9 5v8l9 5zM3.3 7.5 12 12l8.7-4.5M12 22V12"/>',
  'doc': '<path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/>',
  'sun': '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2"/><circle cx="12" cy="12" r="3"/>',
  'layers': '<path d="M9 3h6v4H9zM4 21V7h16v14M9 21v-5h6v5"/>',
  'truck': '<path d="M1 3h15v13H1zM16 8h4l3 3v5h-7zM5.5 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18.5 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>',
  'shield': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  'quote': '',
  'phone': '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9z"/>',
  'mail': '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  'pin': '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  'link': '<path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>',
  'cart': '<path d="M4 20V4h10l6 6v10zM14 4v6h6"/>',
  'whatsapp': '',
};
const filled = name === 'quote' || name === 'whatsapp';
const quotePath = '<path d="M10 7H6a3 3 0 0 0-3 3v7h7v-7H7a1 1 0 0 1 1-1h2zm10 0h-4a3 3 0 0 0-3 3v7h7v-7h-3a1 1 0 0 1 1-1h2z"/>';
const waPath = '<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.06c-.24.68-1.42 1.3-1.96 1.35-.54.05-1.05.24-3.53-.74-2.99-1.18-4.86-4.26-5.01-4.46-.15-.2-1.19-1.58-1.19-3.01s.75-2.14 1.02-2.43c.27-.29.59-.37.79-.37s.4 0 .57.01c.18.01.43-.07.67.51.24.58.83 2.01.9 2.15.07.15.12.32.02.51-.1.2-.15.32-.29.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.26 1.63 2.04 1.12 1 2.07 1.31 2.36 1.46.29.15.46.12.63-.07.17-.2.73-.85.93-1.14.2-.29.39-.24.66-.15.27.1 1.71.81 2 .96.29.15.49.22.56.34.07.12.07.71-.17 1.39z"/>';
const d = name === 'quote' ? quotePath : name === 'whatsapp' ? waPath : paths[name];
---
<svg width={size} height={size} viewBox="0 0 24 24" class={cls} aria-hidden="true"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : (name === 'arrow-right' ? 2.5 : 1.6)}
  stroke-linecap={filled ? undefined : 'round'} set:html={d} />
