---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../layout/PageHero.astro';
import CtaBanner from './CtaBanner.astro';
import Icon from '../primitives/Icon.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';
import { ARTICLE_CATEGORIES } from '../../data/articleCategories';
import { useTranslations, type Lang } from '../../i18n/utils';
import { route } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const articles = (await getCollection('articles', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Categories that actually have content, so no filter ever dead-ends.
const present = [...new Set(articles.map((a) => a.data.category))];
const cats = present.map((k) => ({ key: k, label: ARTICLE_CATEGORIES[k][lang] }));
---
<BaseLayout lang={lang} title={t('pages.articles.title')} description={t('pages.articles.desc')} path="/articles/">
  <PageHero
    lang={lang}
    eyebrow={t('pages.articles.eyebrow')} title={t('pages.articles.title')} description={t('pages.articles.desc')} />

  <section class="bg-white">
    <div class="wrap py-16 md:py-20">
      <div class="flex flex-wrap gap-2" id="chips" data-reveal="up">
        <button type="button" data-f="all" class="chip btn btn-sm btn-primary">{t('pages.articles.filterAll')}</button>
        {cats.map((c) => (
          <button type="button" data-f={c.key} class="chip btn btn-sm btn-outline-ink">{c.label}</button>
        ))}
      </div>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="agrid" data-reveal="stagger">
        {articles.map((a) => (
          <article class="card p-6 flex flex-col" data-cat={a.data.category}>
            <span class="text-[10px] uppercase tracking-[0.14em] text-gold-800 font-bold">
              {ARTICLE_CATEGORIES[a.data.category][lang]}
            </span>
            <h2 class="mt-3 font-semibold text-navy-900 leading-snug">
              <a href={`${route(lang, 'articles')}${a.data.slug}/`} class="hover:text-gold-800 transition-colors">
                {a.data.title}
              </a>
            </h2>
            <p class="mt-3 text-sm text-navy-600 leading-relaxed flex-1">{a.data.summary}</p>
            {a.data.sources.length > 0 ? (
              <p class="mt-5 pt-4 border-t border-navy-200 text-[11px] text-navy-600 specline inline-flex items-center gap-1.5">
                <Icon name="link" size={12} class="shrink-0" />
                {a.data.sources.length} {t('articles.sources')}
              </p>
            ) : (
              <p class="mt-5 pt-4 border-t border-navy-200 text-[11px] text-navy-600 specline">
                {formatDate(a.data.publishedAt, lang)}
              </p>
            )}
          </article>
        ))}
      </div>
      <p class="hidden mt-10 text-sm text-navy-600" id="aempty">{t('pages.articles.empty')}</p>
    </div>
  </section>

  <CtaBanner lang={lang} />
</BaseLayout>
