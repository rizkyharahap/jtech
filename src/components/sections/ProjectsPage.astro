---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../layout/PageHero.astro';
import CtaBanner from './CtaBanner.astro';
import Icon from '../primitives/Icon.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import projA from '../../assets/img/p07.jpeg';
import projB from '../../assets/img/p12.jpeg';
import projC from '../../assets/img/p17.jpeg';
import projD from '../../assets/img/p24.jpeg';
const gallery = [
  { img: projA, alt: { id: 'Peremajaan totem SPBU', en: 'SPBU totem refurbishment' } },
  { img: projB, alt: { id: 'Renovasi signage SPBU', en: 'SPBU signage renovation' } },
  { img: projC, alt: { id: 'Pekerjaan fasilitas SPBU', en: 'SPBU facility works' } },
  { img: projD, alt: { id: 'Signage price board', en: 'Price board signage' } },
];
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = (await getCollection('projects', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const spbu = projects.filter((p) => p.data.sector === 'spbu-energy' || p.data.sector === 'maintenance');
const other = projects.filter((p) => p.data.sector === 'industry' || p.data.sector === 'construction');

const workTypeLabels: Record<string, { id: string; en: string }> = {
  'totem-renovation': { id: 'Peremajaan Totem', en: 'Totem Refurbishment' },
  'totem-foundation-pole': { id: 'Totem & Tiang Pondasi', en: 'Totem & Foundation Pole' },
  'facility-support': { id: 'Pendukung Fasilitas', en: 'Facility Support' },
  repair: { id: 'Jasa Repair', en: 'Repair Service' },
  certification: { id: 'Jasa Sertifikasi', en: 'Certification Service' },
  'console-service': { id: 'Service Console', en: 'Console Service' },
  'atg-seftibar': { id: 'Seftibar & ATG', en: 'Seftibar & ATG' },
};
---
<BaseLayout lang={lang} title={t('pages.projects.title')} description={t('pages.projects.desc')} path="/projects/">
  <PageHero
    lang={lang}
    eyebrow={t('pages.projects.eyebrow')} title={t('pages.projects.title')} description={t('pages.projects.desc')} />

  <section class="bg-white">
    <div class="wrap py-16 md:py-20">
      <h2 class="text-lg font-semibold text-navy-900" data-reveal="up">{t('pages.projects.spbuTitle')}</h2>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal="stagger">
        {spbu.map((p) => (
          <article class="card p-6 flex flex-col">
            <span class="text-[10px] uppercase tracking-[0.14em] text-gold-800 font-bold">
              {workTypeLabels[p.data.workType]?.[lang]}
            </span>
            <h3 class="mt-3 font-semibold text-navy-900 leading-snug">{p.data.title}</h3>
            <dl class="mt-4 space-y-2 text-xs flex-1">
              <div class="flex gap-2">
                <dt class="text-navy-600 shrink-0">{t('pages.projects.clientLabel')}:</dt>
                <dd class="text-navy-900 font-medium">{p.data.clientLabel}</dd>
              </div>
              {p.data.location && (
                <div class="flex gap-2">
                  <dt class="text-navy-600 shrink-0">Lokasi:</dt>
                  <dd class="text-navy-900">{p.data.location}</dd>
                </div>
              )}
              {p.data.year && (
                <div class="flex gap-2">
                  <dt class="text-navy-600 shrink-0">Tahun:</dt>
                  <dd class="text-navy-900 specline">{p.data.year}</dd>
                </div>
              )}
            </dl>
          </article>
        ))}
      </div>

      {/* Real project photography */}
      <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-3" data-reveal="stagger">
        {gallery.map((im) => (
          <figure class="relative overflow-hidden rounded-sm bg-navy-100">
            <Image src={im.img} alt={im.alt[lang]} widths={[300, 600]} sizes="(min-width:1024px) 25vw, 50vw"
                   loading="lazy" class="h-full w-full object-cover aspect-square" />
          </figure>
        ))}
      </div>

      {other.length > 0 && (
        <>
          <h2 class="mt-16 text-lg font-semibold text-navy-900" data-reveal="up">{t('pages.projects.otherTitle')}</h2>
          <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal="stagger">
            {other.map((p) => (
              <article class="border-t-2 border-gold-600 pt-4">
                <h3 class="font-semibold text-navy-900">{p.data.title}</h3>
                <p class="mt-2 text-xs text-navy-600 leading-relaxed">{p.data.clientLabel}</p>
              </article>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <CtaBanner lang={lang} />
</BaseLayout>
