---
interface Props { rows: { label: string; value: string }[]; emptyText: string }
const { rows, emptyText } = Astro.props;
---
{rows.length > 0 ? (
  <dl class="divide-y divide-navy-200 border-y border-navy-200">
    {rows.map((r) => (
      <div class="grid sm:grid-cols-3 gap-2 py-3.5">
        <dt class="text-[11px] uppercase tracking-[0.12em] text-navy-600 font-bold">{r.label}</dt>
        <dd class="sm:col-span-2 text-sm text-navy-900">{r.value}</dd>
      </div>
    ))}
  </dl>
) : (
  <p class="text-sm text-navy-600 border border-dashed border-navy-200 rounded-sm p-5 bg-white">{emptyText}</p>
)}
