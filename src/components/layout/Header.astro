---
import { type Lang, useTranslations } from '../../i18n/utils';
import { NAV, route } from '../../i18n/routes';
import { SITE } from '../../lib/site';
import Logo from '../primitives/Logo.astro';
import Icon from '../primitives/Icon.astro';
import LangToggle from './LangToggle.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = route(lang, 'home');
---
<header id="hdr" class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-navy-200 transition-all duration-300">
  <div class="wrap flex items-center justify-between py-3.5">
    <a href={home} class="flex items-center gap-3 shrink-0">
      <Logo tone="light" />
      <span class="hidden lg:block pl-3 border-l border-navy-200">
        <span class="block text-[10px] uppercase tracking-[0.18em] text-gold-800 font-bold">{SITE.legalName}</span>
        <span class="block text-[10px] uppercase tracking-[0.14em] text-navy-500">Products · Services · Solutions</span>
      </span>
    </a>

    <nav class="hidden xl:flex items-center gap-6 text-[13.5px] font-medium text-navy-700" aria-label="Main">
      {NAV.map((item) => (
        <a href={route(lang, item.key)} class="hover:text-gold-800 transition-colors">{t(item.label)}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LangToggle lang={lang} label={t('nav.langLabel')} />
      <a href={route(lang, 'contact')} class="btn btn-on-dark btn-sm hidden sm:inline-flex">{t('nav.cta')}</a>

      <details class="nav-dd xl:hidden relative">
        <summary class="cursor-pointer p-3 -mr-2 text-gold-800" aria-label={t('nav.menu')}>
          <Icon name="box" size={22} class="hidden" />
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded border border-navy-200 bg-white p-3 shadow-2xl">
          {NAV.map((item) => (
            <a href={route(lang, item.key)} class="block px-3 py-2 text-sm text-navy-700 hover:text-gold-800">{t(item.label)}</a>
          ))}
          <a href={route(lang, 'contact')} class="btn btn-on-dark btn-sm w-full mt-2">{t('nav.cta')}</a>
        </div>
      </details>
    </div>
  </div>
</header>
